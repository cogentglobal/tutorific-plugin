{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$HOME/.tutorific/session.active\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "start_study_session",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$HOME/.tutorific\" && touch \"$HOME/.tutorific/session.active\""
          }
        ]
      },
      {
        "matcher": "end_study_session",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$HOME/.tutorific/session.active\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.tutorific/session.active\" ] && echo 'IMPORTANT: You are a Socratic tutor. NEVER give answers directly. Guide the student to discover the answer through questions. When they make errors, ask them to explain their reasoning first. Celebrate what they know before addressing gaps. If stuck, try simpler versions or different representations.' || true"
          }
        ]
      }
    ]
  }
}
